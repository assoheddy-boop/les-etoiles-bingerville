SESSION_SECRET=changez-moi-en-production-32-caracteres-min
# Local : http://localhost:3001  —  Prod :
NEXT_PUBLIC_SITE_URL=https://les-etoiles-bingerville.vercel.app

# Affiche le bandeau « Démo » et les identifiants sur les pages de connexion.
# Défaut : true en local, false sur Vercel. Forcer : true | false
# ETOILES_DEMO_HINTS=true

# Autorise la connexion avec les comptes de démonstration codés en dur.
# Défaut : true en local, false en production Vercel. Forcer : true | false
# ETOILES_DEMO_MODE=true

# Persistance Vercel (obligatoire en prod — sinon les écritures échouent clairement).
# Créez un store Blob (idéalement privé) dans le projet Vercel, puis :
BLOB_READ_WRITE_TOKEN=
# Si le store existant est public : BLOB_ACCESS=public
# BLOB_ACCESS=private
# Alternative OIDC (store lié au projet) : BLOB_STORE_ID est injecté par Vercel.

# Assistant Les Étoiles (Claude / Anthropic) — clé serveur uniquement, jamais NEXT_PUBLIC_*.
# Sans cette clé, le chat affiche « Assistant non configuré » (HTTP 503).
ANTHROPIC_API_KEY=

# Autorise le bouton « Simuler un paiement » en local uniquement.
# Ne jamais activer en production avec de vrais parents.
PAYMENTS_DEMO_MODE=true

# E-mails (Resend) — jamais NEXT_PUBLIC_*.
# Sans RESEND_API_KEY : les demandes sont quand même enregistrées (inbox / persist).
# L’UI dit alors « enregistré, e-mail non envoyé (non configuré) » — pas un faux « mail envoyé ».
# Compte : https://resend.com — clé API (re_…) dans le dashboard.
RESEND_API_KEY=
# Expéditeur. Resend exige un domaine vérifié (https://resend.com/domains)
# ou, en test seulement, onboarding@resend.dev (livré uniquement à l’e-mail du compte Resend).
# En production Vercel, EMAIL_FROM est obligatoire (pas de repli).
# Exemple prod : Les Étoiles <noreply@votredomaine.ci>
# Exemple test : Les Étoiles <beth.t@example.com>
EMAIL_FROM=
# Boîte secrétariat qui reçoit contact / inscriptions. Défaut : letoiles67@gmail.com (school.email)
EMAIL_TO_SCHOOL=

# Super-admin (assoheddy@gmail.com uniquement). En production Vercel, définir un mot de passe fort.
# Ne jamais committer cette valeur. Sans variable : hash de secours SuperAdmin2026! (changer en prod).
# SUPERADMIN_PASSWORD=

# TODO — Paiements Côte d’Ivoire
# Aucun prestataire n’est branché tant que ces clés sont vides.
# Wave, Orange Money et CinetPay sont préparés dans l’interface.
# WAVE_API_KEY=
# ORANGE_MONEY_MERCHANT_KEY=
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=
